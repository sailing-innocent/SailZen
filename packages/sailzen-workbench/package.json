{
  "name": "sailzen-workbench",
  "displayName": "SailZen Workbench",
  "description": "SailZen 3.0 Work & Creation Workbench — fast dot-hierarchy notes, Rhythm v2 + SailTick, Content 2.0, and multi-machine project workflows.",
  "version": "0.3.0",
  "publisher": "SailingInnocent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sailzen/sailzen"
  },
  "private": false,
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sailzen",
    "workbench",
    "markdown",
    "notes",
    "rhythm",
    "writing"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sailzen-workbench",
          "title": "SailZen",
          "icon": "media/icons/sailzen.svg"
        }
      ]
    },
    "views": {
      "sailzen-workbench": [
        {
          "id": "sailzen.rhythmView",
          "name": "Today & Rhythm"
        },
        {
          "id": "sailzen.quickChatView",
          "name": "SailTick QuickChat",
          "type": "webview"
        },
        {
          "id": "sailzen.projectsView",
          "name": "Projects & Content"
        },
        {
          "id": "sailzen.vaultTreeView",
          "name": "Vault Tree"
        },
        {
          "id": "sailzen.calendarView",
          "name": "Calendar",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "sailzen.lookupNote",
        "title": "SailZen: Lookup / Create Note",
        "icon": "$(search)"
      },
      {
        "command": "sailzen.openProjectNote",
        "title": "SailZen: Lookup Note in Active Project",
        "icon": "$(folder-library)"
      },
      {
        "command": "sailzen.gotoToday",
        "title": "SailZen: Open Today's Journal",
        "icon": "$(calendar)"
      },
      {
        "command": "sailzen.createNote",
        "title": "SailZen: Create Note",
        "icon": "$(new-file)"
      },
      {
        "command": "sailzen.createChildNote",
        "title": "SailZen: Create Child Note",
        "icon": "$(new-file)"
      },
      {
        "command": "sailzen.deleteNote",
        "title": "SailZen: Delete Note (Move to Trash)",
        "icon": "$(trash)"
      },
      {
        "command": "sailzen.renameNote",
        "title": "SailZen: Rename Note (Update Links)",
        "icon": "$(edit)"
      },
      {
        "command": "sailzen.batchRenameNote",
        "title": "SailZen: Batch Rename Notes (Update Links)",
        "icon": "$(replace-all)"
      },
      {
        "command": "sailzen.refactorHierarchy",
        "title": "SailZen: Refactor Hierarchy (Update Links)",
        "icon": "$(list-tree)"
      },
      {
        "command": "sailzen.copyNoteLink",
        "title": "SailZen: Copy Note Wikilink",
        "icon": "$(copy)"
      },
      {
        "command": "sailzen.goUpHierarchy",
        "title": "SailZen: Go Up Hierarchy"
      },
      {
        "command": "sailzen.reloadVault",
        "title": "SailZen: Reload Vault Index",
        "icon": "$(refresh)"
      },
      {
        "command": "sailzen.switchVault",
        "title": "SailZen: Switch Active Vault (Private / Work)"
      },
      {
        "command": "sailzen.toggleTreeProjectFilter",
        "title": "SailZen: Toggle Project Filter in Vault Tree",
        "icon": "$(filter)"
      },
      {
        "command": "sailzen.refreshRhythm",
        "title": "SailZen: Refresh Rhythm & Projects",
        "icon": "$(sync)"
      },
      {
        "command": "sailzen.blockSetStatus",
        "title": "SailZen: Set Rhythm Block Status"
      },
      {
        "command": "sailzen.syncJournalRhythm",
        "title": "SailZen: Pull Today's Rhythm into Journal"
      },
      {
        "command": "sailzen.pushSelectionToRhythm",
        "title": "SailZen: Push Selection to Rhythm Task"
      },
      {
        "command": "sailzen.addQuickTask",
        "title": "SailZen: Quick Add Rhythm Task",
        "icon": "$(add)"
      },
      {
        "command": "sailzen.completeMilestone",
        "title": "SailZen: Complete Project Milestone",
        "icon": "$(check)"
      },
      {
        "command": "sailzen.bindProjectToCurrentFolder",
        "title": "SailZen: Bind Venture Project to Current Folder",
        "icon": "$(link)"
      },
      {
        "command": "sailzen.configureProjectMeta",
        "title": "SailZen: Configure Venture Semantic Metadata",
        "icon": "$(settings)"
      },
      {
        "command": "sailzen.syncVaultContent",
        "title": "SailZen: Sync Vault ↔ Content 2.0 (Fenced)",
        "icon": "$(cloud-download)"
      },
      {
        "command": "sailzen.syncWorkToVault",
        "title": "SailZen: Export Work Reading Card & Clips to Vault",
        "icon": "$(desktop-download)"
      },
      {
        "command": "sailzen.pushTopicTask",
        "title": "SailZen: Push Topic Task to Rhythm",
        "icon": "$(tasklist)"
      },
      {
        "command": "sailzen.copyContextPack",
        "title": "SailZen: Copy AI Project Context Pack",
        "icon": "$(sparkle)"
      },
      {
        "command": "sailzen.writeContextPackFile",
        "title": "SailZen: Write AI Context Pack (.sailzen/context-pack.md)",
        "icon": "$(file-code)"
      },
      {
        "command": "sailzen.searchLibrary",
        "title": "SailZen: Search Cloud Library (Works & Chapters)",
        "icon": "$(search)"
      },
      {
        "command": "sailzen.togglePinWork",
        "title": "SailZen: Pin / Unpin Work",
        "icon": "$(pin)"
      },
      {
        "command": "sailzen.syncChapterToCloud",
        "title": "SailZen: Novel — Sync Current Chapter to Cloud",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "sailzen.reviewNoteItemDiff",
        "title": "SailZen: Novel/AI — Diff Local Note vs Cloud NoteItem",
        "icon": "$(diff)"
      },
      {
        "command": "sailzen.copySemanticCodeLink",
        "title": "SailZen: Copy Cross-Machine Code Link (repo://)",
        "icon": "$(link)"
      },
      {
        "command": "sailzen.logToTodayJournal",
        "title": "SailZen: Log Code Context to Today's Journal",
        "icon": "$(notebook)"
      },
      {
        "command": "sailzen.insertPaperReference",
        "title": "SailZen: Research — Insert Paper / Book Reference",
        "icon": "$(references)"
      },
      {
        "command": "sailzen.openMachineConfig",
        "title": "SailZen: Open Machine Config (~/.sailzen/machine.json)",
        "icon": "$(gear)"
      },
      {
        "command": "sailzen.checkForUpdate",
        "title": "SailZen: Check for Workbench Update (OTA)",
        "icon": "$(cloud-download)"
      },
      {
        "command": "sailzen.showDiagnostics",
        "title": "SailZen: Workbench Diagnostics"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sailzen.addQuickTask",
          "when": "view == sailzen.rhythmView",
          "group": "navigation@1"
        },
        {
          "command": "sailzen.refreshRhythm",
          "when": "view == sailzen.rhythmView || view == sailzen.projectsView",
          "group": "navigation@2"
        },
        {
          "command": "sailzen.bindProjectToCurrentFolder",
          "when": "view == sailzen.projectsView",
          "group": "navigation@1"
        },
        {
          "command": "sailzen.searchLibrary",
          "when": "view == sailzen.projectsView",
          "group": "navigation@2"
        },
        {
          "command": "sailzen.syncVaultContent",
          "when": "view == sailzen.projectsView",
          "group": "navigation@3"
        },
        {
          "command": "sailzen.lookupNote",
          "when": "view == sailzen.vaultTreeView",
          "group": "navigation@1"
        },
        {
          "command": "sailzen.toggleTreeProjectFilter",
          "when": "view == sailzen.vaultTreeView",
          "group": "navigation@2"
        },
        {
          "command": "sailzen.reloadVault",
          "when": "view == sailzen.vaultTreeView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "sailzen.blockSetStatus",
          "when": "view == sailzen.rhythmView && viewItem == rhythmBlock",
          "group": "inline"
        },
        {
          "command": "sailzen.completeMilestone",
          "when": "view == sailzen.projectsView && viewItem == ventureMilestone",
          "group": "inline"
        },
        {
          "command": "sailzen.copyContextPack",
          "when": "view == sailzen.projectsView && viewItem == ventureProject",
          "group": "inline@1"
        },
        {
          "command": "sailzen.configureProjectMeta",
          "when": "view == sailzen.projectsView && viewItem == ventureProject",
          "group": "sailzen@1"
        },
        {
          "command": "sailzen.togglePinWork",
          "when": "view == sailzen.projectsView && viewItem == contentWork",
          "group": "inline@1"
        },
        {
          "command": "sailzen.syncWorkToVault",
          "when": "view == sailzen.projectsView && viewItem == contentWork",
          "group": "inline@2"
        },
        {
          "command": "sailzen.pushTopicTask",
          "when": "view == sailzen.projectsView && viewItem == contentTopic",
          "group": "inline"
        },
        {
          "command": "sailzen.createChildNote",
          "when": "view == sailzen.vaultTreeView && (viewItem == vaultNote || viewItem == vaultStub)",
          "group": "inline@1"
        },
        {
          "command": "sailzen.copyNoteLink",
          "when": "view == sailzen.vaultTreeView && viewItem == vaultNote",
          "group": "sailzen@1"
        },
        {
          "command": "sailzen.renameNote",
          "when": "view == sailzen.vaultTreeView && viewItem == vaultNote",
          "group": "sailzen@2"
        },
        {
          "command": "sailzen.refactorHierarchy",
          "when": "view == sailzen.vaultTreeView && (viewItem == vaultNote || viewItem == vaultStub)",
          "group": "sailzen@3"
        },
        {
          "command": "sailzen.batchRenameNote",
          "when": "view == sailzen.vaultTreeView && (viewItem == vaultNote || viewItem == vaultStub)",
          "group": "sailzen@4"
        },
        {
          "command": "sailzen.deleteNote",
          "when": "view == sailzen.vaultTreeView && viewItem == vaultNote",
          "group": "sailzen@9"
        }
      ],
      "editor/context": [
        {
          "command": "sailzen.copyNoteLink",
          "when": "editorLangId == markdown",
          "group": "sailzen@1"
        },
        {
          "command": "sailzen.renameNote",
          "when": "editorLangId == markdown",
          "group": "sailzen@2"
        },
        {
          "command": "sailzen.deleteNote",
          "when": "editorLangId == markdown",
          "group": "sailzen@3"
        },
        {
          "command": "sailzen.pushSelectionToRhythm",
          "when": "editorHasSelection",
          "group": "sailzen@4"
        },
        {
          "command": "sailzen.syncJournalRhythm",
          "when": "editorLangId == markdown",
          "group": "sailzen@5"
        },
        {
          "command": "sailzen.syncChapterToCloud",
          "when": "editorLangId == markdown",
          "group": "sailzen@6"
        },
        {
          "command": "sailzen.insertPaperReference",
          "when": "editorLangId == markdown",
          "group": "sailzen@7"
        },
        {
          "command": "sailzen.copySemanticCodeLink",
          "when": "editorLangId != markdown",
          "group": "sailzen@1"
        },
        {
          "command": "sailzen.logToTodayJournal",
          "when": "editorLangId != markdown",
          "group": "sailzen@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sailzen.lookupNote",
        "key": "ctrl+l",
        "mac": "cmd+l"
      },
      {
        "command": "sailzen.gotoToday",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i"
      },
      {
        "command": "sailzen.copyNoteLink",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorFocus && editorLangId == markdown"
      },
      {
        "command": "sailzen.deleteNote",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "editorFocus && editorLangId == markdown"
      },
      {
        "command": "sailzen.goUpHierarchy",
        "key": "ctrl+shift+up",
        "mac": "cmd+shift+up",
        "when": "editorFocus && editorLangId == markdown"
      }
    ],
    "configuration": {
      "title": "SailZen Workbench",
      "properties": {
        "sailzen.server.baseUrl": {
          "type": "string",
          "default": "http://localhost:1974",
          "description": "SailZen 后端地址（如未在 ~/.sailzen/machine.json 中配置时回退使用）。"
        },
        "sailzen.server.apiToken": {
          "type": "string",
          "default": "",
          "description": "可选 Bearer Token（SAILZEN_API_TOKEN），也可配置在 ~/.sailzen/machine.json 中。"
        },
        "sailzen.vault.privatePath": {
          "type": "string",
          "default": "",
          "description": "私人 Vault 根目录（如 D:/vault），优先从 ~/.sailzen/machine.json 读取。"
        },
        "sailzen.vault.workPath": {
          "type": "string",
          "default": "",
          "description": "工作 Vault 根目录（强制离线，禁止向个人云端上报）。"
        },
        "sailzen.rhythm.autoRefreshMinutes": {
          "type": "number",
          "default": 5,
          "description": "Rhythm 与项目面板后台自动刷新间隔（分钟），0 表示仅手动刷新。"
        },
        "sailzen.updater.checkOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "启动时静默检查云端 SailZen Workbench 最新 VSIX 版本（工作库离线模式自动跳过）。"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.config.mjs --production"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/jest": "catalog:",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "catalog:",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "typescript": "catalog:"
  }
}
