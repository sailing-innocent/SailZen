{
  "name": "sail-site",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite --mode=development",
    "debug": "cross-env NODE_ENV=debug vite --mode=debug",
    "build": "tsc --noEmit && cross-env NODE_ENV=production vite build --mode=production",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "cross-env NODE_ENV=development jest",
    "mock:install": "cd mock && bun install",
    "mock:start": "cd mock && bun run start",
    "mock:dev": "cd mock && bun run dev",
    "dev:full": "concurrently \"bun run mock:start\" \"bun run dev\""
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.13",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slider": "^1.4.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.2",
    "@xyflow/react": "^12.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.17.0",
    "react": "catalog:",
    "react-day-picker": "^10.0.1",
    "react-dom": "catalog:",
    "react-router-dom": "^7.17.0",
    "react-virtuoso": "^4.18.7",
    "recharts": "3.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.4.4",
    "@storybook/addon-themes": "^10.4.4",
    "@storybook/react-vite": "^10.4.4",
    "@types/jest": "catalog:",
    "@types/node": "^25.9.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "10.4.4",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "storybook": "^10.4.4",
    "ts-jest": "^29.4.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "^8.0.16"
  }
}
