        },
        {
          "command": "sail.treeView.labelByTitle",
          "when": "view == sail.treeView && sail:treeviewItemLabelType == filename"
        },
        {
          "command": "sail.treeView.labelByFilename",
          "when": "view == sail.treeView && sail:treeviewItemLabelType == title"
        },
        {
          "command": "sail.treeView.expandAll",
          "when": "view == sail.treeView && sail:devMode",
          "group": "navigation@2"
        },
        {
          "command": "sail.treeView.createNote",
          "when": "view == sail.treeView",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "when": "explorerResourceIsFolder && sail:pluginActive && workspaceFolderCount > 1 && shellExecutionSupported",
          "command": "sail.vaultAdd",
          "group": "2_workspace"
        },
        {
          "when": "explorerResourceIsFolder && sail:pluginActive && shellExecutionSupported",
          "command": "sail.removeVault",
          "group": "2_workspace"
        },
        {
          "when": "resourceExtname == .md && sail:pluginActive && shellExecutionSupported || resourceExtname == .yml && sail:pluginActive && shellExecutionSupported",
          "command": "sail.delete",
          "group": "2_workspace"
        },
        {
          "when": "resourceExtname == .md && sail:pluginActive && shellExecutionSupported",
          "command": "sail.moveNote",
          "group": "2_workspace"
        },
        {
          "command": "sail.togglePreview",
          "when": "resourceLangId == markdown && sail:pluginActive",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "when": "resourceExtname == .md && sail:pluginActive && shellExecutionSupported",
          "command": "sail.copyNoteLink",
          "group": "2_workspace"
        }
      ],
      "editor/title": [
        {
          "command": "sail.togglePreview",
          "when": "editorLangId == markdown && !notebookEditorFocused && sail:pluginActive",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "sail.togglePreview",
          "when": "resourceLangId == markdown && sail:pluginActive",
          "group": "1_open"
        }
      ],
      "view/item/context": [
        {
          "command": "sail.delete",
          "when": "view == sail.treeView && viewItem == note && shellExecutionSupported"
        },
        {
          "command": "sail.createNote",
          "when": "view == sail.treeView && shellExecutionSupported"
        },
        {
          "command": "sail.treeView.gotoNote",
          "when": "view == sail.treeView && viewItem == stub && shellExecutionSupported",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "sail",
      "properties": {
        "sail.dailyJournalDomain": {
          "type": "string",
          "default": "daily",
          "description": "DEPRECATED. Use journal settings in sail.yml"
        },
        "sail.defaultJournalName": {
          "type": "string",
          "default": "journal",
          "description": "DEPRECATED. Use journal settings in sail.yml"
        },
        "sail.defaultJournalDateFormat": {
          "type": "string",
          "default": "y.MM.dd",
          "description": "DEPRECATED. Use journal settings in sail.yml"
        },
        "sail.defaultJournalAddBehavior": {
          "default": "childOfDomain",
          "type": "string",
          "description": "DEPRECATED. Use journal settings in sail.yml",
          "enum": [
            "childOfDomain",
            "childOfDomainNamespace",
            "childOfCurrent",
            "asOwnDomain"
          ]
        },
        "sail.defaultScratchName": {
          "type": "string",
          "default": "scratch",
          "description": "DEPRECATED. Use scratch settings in sail.yml"
        },
        "sail.defaultScratchDateFormat": {
          "type": "string",
          "default": "y.MM.dd.HHmmss",
          "description": "DEPRECATED. Use scratch settings in sail.yml"
        },
        "sail.defaultScratchAddBehavior": {
          "default": "asOwnDomain",
          "type": "string",
          "description": "DEPRECATED. Use scratch settings in sail.yml",
          "enum": [
            "childOfDomain",
            "childOfDomainNamespace",
            "childOfCurrent",
            "asOwnDomain"
          ]
        },
        "sail.copyNoteUrlRoot": {
          "type": "string",
          "description": "override root url when getting note url"
        },
        "sail.linkSelectAutoTitleBehavior": {
          "type": "string",
          "description": "Control title behavior when using selection2link with lookup",
          "enum": [
            "none",
            "slug"
          ],
          "default": "slug"
        },
        "sail.defaultLookupCreateBehavior": {
          "default": "selectionExtract",
          "type": "string",
          "description": "when creating a new note with selected text, define behavior for selected text",
          "enum": [
            "selection2link",
            "selectionExtract"
          ]
        },
        "sail.defaultTimestampDecorationFormat": {
          "default": "DATETIME_MED",
          "type": "string",
          "description": "Decide how human readable timestamp decoration is displayed",
          "enum": [
            "DATETIME_FULL",
            "DATETIME_FULL_WITH_SECONDS",
            "DATETIME_HUGE",
            "DATETIME_HUGE_WITH_SECONDS",
            "DATETIME_MED",
            "DATETIME_MED_WITH_SECONDS",
            "DATETIME_SHORT",
            "DATETIME_SHORT_WITH_SECONDS",
            "DATE_FULL",
            "DATE_HUGE",
            "DATE_MED",
            "DATE_MED_WITH_WEEKDAY",
            "DATE_SHORT",
            "TIME_24_SIMPLE",
            "TIME_24_WITH_LONG_OFFSET",
            "TIME_24_WITH_SECONDS",
            "TIME_24_WITH_SHORT_OFFSET",
            "TIME_SIMPLE",
            "TIME_WITH_LONG_OFFSET",
            "TIME_WITH_SECONDS",
            "TIME_WITH_SHORT_OFFSET"
          ]
        },
        "sail.rootDir": {
          "type": "string",
          "default": "",
          "description": "location of sail workspace"
        },
        "sail.sailDir": {
          "type": "string",
          "default": "",
          "description": "DEPRECATED. Use journal settings in sail.yml"
        },
        "sail.logLevel": {
          "type": "string",
          "default": "info",
          "description": "control verbosity of sail logs",
          "enum": [
            "debug",
            "info",
            "error"
          ]
        },
        "sail.trace.server": {
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "type": "string",
          "default": "messages",
          "description": "LSP log level"
        },
        "sail.serverPort": {
          "type": "number",
          "description": "port for server. If not set, will be randomly generated at startup."
        },
        "sail.enableSelfContainedVaultWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, newly created workspaces will be created as self contained vaults."
        },
        "sailzen.doc.useASTPipeline": {
          "type": "boolean",
          "default": true,
          "description": "Use the new AST-based document pipeline (unified/remark) instead of regex-driven conversion."
        },
        "sailzen.doc.defaultBuildEngine": {
          "type": "string",
          "default": "latexmk",
          "description": "Default build engine for LaTeX documents.",
          "enum": [
            "latexmk",
            "xmake"
          ]
        }
      }
    },
    "keybindings": [
      {
        "command": "sail.zotero.CitationPicker",
        "key": "alt+shift+z"
      },
      {
        "command": "sail.zotero.openInZotero",
        "key": "ctrl+shift+z"
      },
      {
        "command": "sail.zotero.openPDFZotero",
        "key": "ctrl+alt+shift+z"
      },
      {
        "command": "sail.goto",
        "when": "editorFocus"
      },
      {
        "command": "sail.gotoNote",
        "key": "ctrl+k g",
        "when": "editorFocus"
      },
      {
        "command": "sail.createSchemaFromHierarchy",
        "when": "editorFocus && sail:pluginActive"
      },
      {
        "command": "sail.createDailyJournalNote",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "sail:pluginActive && shellExecutionSupported"
      },
      {
        "command": "sail.copyNoteLink",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorFocus && sail:pluginActive"
      },
      {
        "command": "sail.copyNoteRef",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorFocus && sail:pluginActive"
      },
      {
        "command": "sail.copyAs",
        "key": "ctrl+k ctrl+c",
        "mac": "cmd+k cmd+c",
        "when": "sail:pluginActive"
      },
      {
        "command": "sail.delete",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "sail:pluginActive && shellExecutionSupported"
      },
      {
        "command": "sail.lookupNote",
        "mac": "cmd+L",
        "key": "ctrl+l",
        "when": "sail:pluginActive"
      },
      {
        "command": "sail.lookupNoteAutoComplete",
        "key": "Tab",
        "when": "sail:pluginActive && sail:noteLookupActive && !editorFocus && !view"
      },
      {
        "command": "sail.createJournalNote",
        "key": "ctrl+shift+j",
        "mac": "cmd+shift+j",
        "args": {
          "noteType": "journal"
        },
        "when": "sail:pluginActive && shellExecutionSupported"
      },
      {
        "command": "sail.createScratchNote",
        "key": "ctrl+k s",
        "mac": "cmd+k s",
        "when": "sail:pluginActive && shellExecutionSupported"
      },
      {
        "command": "sail.lookupSchema",
        "mac": "cmd+shift+L",
        "key": "ctrl+shift+l",
        "when": "sail:pluginActive && shellExecutionSupported"
      },
      {
        "command": "sail.goUpHierarchy",
        "mac": "cmd+shift+up",
        "key": "ctrl+shift+up",
        "when": "editorFocus && sail:pluginActive"
      },
      {
        "command": "sail.goNextHierarchy",
        "key": "ctrl+shift+]",
        "when": "editorFocus && sail:pluginActive"
      },
      {
        "command": "sail.goPrevHierarchy",
        "key": "ctrl+shift+[",
        "when": "editorFocus && sail:pluginActive"
      },
      {
        "command": "sail.goDownHierarchy",
        "mac": "cmd+shift+down",
        "key": "ctrl+shift+down",
        "when": "editorFocus && sail:pluginActive"
      },
      {
        "command": "sail.copyNoteURL",
        "mac": "cmd+shift+u",
        "windows": "ctrl+shift+u",
        "when": "editorFocus && sail:pluginActive"
      },
      {
        "command": "sail.togglePreview",
        "key": "ctrl+k v",
        "mac": "cmd+ctrl+p",
        "when": "sail:pluginActive"
      }
    ],
    "markdown.previewStyles": [
      "./media/fontello/css/fontello.css",
      "./media/markdown.css"
    ]
  },
  "scripts": {
    "build": "pnpm run compile",
    "precompile": "pnpm --filter=@saili/engine-server run buildCI && pnpm --filter=@saili/sail-plugin-views run build && pnpm --filter=@saili/sail-plugin-views run copy-to-plugin",
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --platform=node --external:vscode --external:better-sqlite3 --external:unist --external:mdast --format=cjs --sourcemap=inline --sources-content=true --tsconfig=tsconfig.json --log-override:empty-import-meta=silent --log-override:commonjs-variable-in-esm=silent && node scripts/fix-import-meta.js && node scripts/copy-prisma-assets.js",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --platform=node --external:vscode --external:better-sqlite3 --external:unist --external:mdast --format=cjs --sourcemap=inline --sources-content=true --watch --tsconfig=tsconfig.json --log-override:empty-import-meta=silent --log-override:commonjs-variable-in-esm=silent",
    "package": "vsce package --no-dependencies",
    "clean": "rimraf dist node_modules",
    "vscode:prepublish": "pnpm run compile",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
