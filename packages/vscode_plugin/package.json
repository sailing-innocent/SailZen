{
  "name": "sail-zen-vscode",
  "private": false,
  "license": "MIT",
  "displayName": "SailZen",
  "description": "Sailing-Innocent's vscode extension based on Sail",
  "publisher": "SailingInnocent",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/sailzen/sailzen"
  },
  "engines": {
    "vscode": "^1.107.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "second brain",
    "markdown",
    "roam",
    "notes",
    "schema"
  ],
  "icon": "media/logo.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "markdown",
        "extensions": [
          ".md"
        ],
        "aliases": [
          "markdown"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "viewsWelcome": [
      {
        "view": "sail.backlinks",
        "contents": "There are no backlinks to this note."
      },
      {
        "view": "sail.recent-workspaces",
        "contents": "No recent workspaces detected."
      },
      {
        "view": "sail.treeView",
        "contents": "First open a Sail note to see the tree view."
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sail-view",
          "title": "Sail",
          "icon": "media/icons/simple.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "sail.sample",
          "name": "Sample View",
          "type": "webview",
          "when": "sail:devMode"
        }
      ],
      "sail-view": [
        {
          "id": "sail.backlinks",
          "name": "Backlinks",
          "when": "sail:pluginActive && shellExecutionSupported"
        },
        {
          "id": "sail.treeView",
          "name": "Tree View",
          "when": "sail:pluginActive",
          "icon": "media/icons/tree.svg"
        },
        {
          "id": "sail.lookup-view",
          "name": "Lookup View",
          "type": "webview",
          "when": "sail:pluginActive && sail:noteLookupActive && sail:shouldShowLookupView"
        },
        {
          "id": "sail.calendar-view",
          "name": "Calendar View",
          "type": "webview",
          "when": "sail:pluginActive && shellExecutionSupported"
        },
        {
          "id": "sail.recent-workspaces",
          "name": "Recent Sail Workspaces",
          "when": "!sail:pluginActive && shellExecutionSupported"
        }
      ]
    },
