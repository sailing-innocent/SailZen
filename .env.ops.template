# =============================================================================
# SailZen 自动化运维配置模板 (.env.ops.template)
# =============================================================================
# 使用方法:
#   Copy-Item .env.ops.template .env.ops
#   按实际云端环境填写后保存（.env.ops 已在 .gitignore 排除，严禁提交！）
#
# 设计原则（凭据收敛，不重复填密码）:
#   - 生产库连接串与 API Token 直接复用 .env.prod（POSTGRE_URI / SAILZEN_API_TOKEN）
#   - 本地调试库连接串直接复用 .env.dev（POSTGRE_URI / SERVER_PORT）
#   - 本文件只收敛 SSH、云端部署路径、systemd 服务名与备份策略
#   - 若更习惯把 OPS_* 变量直接追加到 .env.prod，scripts/ops 也会自动兜底读取
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 环境文件指针（复用现有 .env.prod / .env.dev，无需重复填数据库密码）
# -----------------------------------------------------------------------------
OPS_PROD_ENV_FILE=.env.prod
OPS_DEV_ENV_FILE=.env.dev

# -----------------------------------------------------------------------------
# 2. PostgreSQL 客户端与备份策略
# -----------------------------------------------------------------------------
# 备份模式:
#   - direct: 本机调用 pg_dump 直接只读导出 .env.prod 中的 POSTGRE_URI（默认，配合 pgAdmin4/PG 客户端即可用）
#   - ssh:    通过 SSH 在云端本机执行 pg_dump -Fc 再 scp 拉回（云端 5432 不对外开放时使用）
OPS_BACKUP_MODE=direct

# 备份归档目录（已在 .gitignore 的 /data 与 *.dump 中排除）
OPS_BACKUP_DIR=data/backups

# 本地备份保留天数（超出自动滚动清理）
OPS_BACKUP_KEEP_DAYS=14

# 本机 PostgreSQL / pgAdmin4 工具目录（留空则自动探测 PATH / PostgreSQL/*/bin / pgAdmin 4/runtime）
# 示例: C:/Program Files/PostgreSQL/19/bin 或 C:/Program Files/pgAdmin 4/runtime
OPS_PG_BIN_DIR=

# 仅 OPS_BACKUP_MODE=ssh 时生效：云端本机 pg_dump 使用的库名与用户
OPS_REMOTE_PG_DB=main
OPS_REMOTE_PG_USER=postgres

# -----------------------------------------------------------------------------
# 3. 云端 Linux 服务器 SSH 配置（用于自动化部署、远程体检与回滚）
# -----------------------------------------------------------------------------
# 推荐在 ~/.ssh/config 中配置免密公钥别名（如 Host sailzen-prod），此处填别名即可；
# 也可直接填公网 IP 或域名（若留空且配置了 OPS_SSH_USER，将自动从 .env.prod 的 POSTGRE_URI 提取主机名）
OPS_SSH_HOST=sailzen-prod

# SSH 用户名（当 OPS_SSH_HOST 不是 ~/.ssh/config 别名时生效）
OPS_SSH_USER=ubuntu

# SSH 端口（默认 22）
OPS_SSH_PORT=22

# SSH 私钥路径（可选；使用 ~/.ssh/config 或 ssh-agent 时可留空）
# 示例: C:/Users/<you>/.ssh/id_ed25519
OPS_SSH_KEY=

# -----------------------------------------------------------------------------
# 4. 云端部署路径与 systemd 服务名
# -----------------------------------------------------------------------------
# 云端 SailZen 仓库绝对路径
OPS_REMOTE_REPO=/home/ubuntu/repos/SailZen

# 云端 Web 前端静态目录（需与云端 .env.prod 的 SITE_DIST 一致）
OPS_REMOTE_SITE_DIST=/home/ubuntu/repos/SailZen/site_dist

# 云端 sail_server systemd 服务名（统一标准为 sailzen-server.service，老环境若仍是 my-server.service 请按实际填写）
OPS_REMOTE_SERVER_SERVICE=sailzen-server.service

# 云端 SailTick systemd 服务名（--with-sailtick 时重启与体检）
OPS_REMOTE_SAILTICK_SERVICE=sailtick.service

# 云端 uv / pnpm 可执行文件路径（如 /home/ubuntu/.local/bin/uv 或 /home/ubuntu/pyv_ws/bin/uv）
OPS_REMOTE_UV_BIN=uv
OPS_REMOTE_PNPM_BIN=pnpm

# Web 前端构建方式:
#   - remote（默认）: 同步代码后在云端直接执行 pnpm build-site（与人工云端操作一致）
#   - local:          本机执行 pnpm run build-site 后打包 scp 上传并原子替换
OPS_SITE_BUILD_MODE=remote

# 云端重启 systemd 是否使用 sudo（推荐配置 NOPASSWD 仅放行 systemctl restart/status）
OPS_REMOTE_USE_SUDO=true

# 云端公网访问 URL（供 health_check.py 体检；留空则按 .env.prod 的 POSTGRE_URI 主机 + SERVER_PORT 推算）
# 示例: http://1.2.3.4:1974 或 https://sailzen.example.com
OPS_REMOTE_PUBLIC_URL=

# 云端 SailTick 管理 API 本地地址（仅通过 SSH 在云端本机访问）
OPS_REMOTE_SAILTICK_URL=http://127.0.0.1:9070
