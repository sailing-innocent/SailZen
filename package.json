{
    "name": "@saili/sailzen",
    "private": true,
    "scripts": {
        "install-site": "pnpm install --filter=sail-site",
        "build-site": "pnpm -r --filter=sail-site run build",
        "dev:site": "pnpm --filter=sail-site run dev",
        "install-workbench": "pnpm install --filter=sailzen-workbench",
        "build-workbench": "pnpm --filter=sailzen-workbench run build",
        "test:workbench": "pnpm --filter=sailzen-workbench run test",
        "package-workbench": "pnpm --filter=sailzen-workbench run package",
        "publish-workbench": "uv run python scripts/ops/publish_vscode_vsix.py",
        "test": "pnpm --filter=sailzen-workbench run test",
        "version:patch": "node scripts/bump-version.js patch",
        "version:minor": "node scripts/bump-version.js minor",
        "version:major": "node scripts/bump-version.js major"
    },
    "allowBuilds": {
        "@parcel/watcher": true,
        "@vscode/vsce-sign": true,
        "esbuild": true,
        "keytar": true,
        "unrs-resolver": true
    },
    "devDependencies": {
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@radix-ui/react-dropdown-menu": "^2.1.24"
    }
}
