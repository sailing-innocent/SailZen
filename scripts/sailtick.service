# systemd unit: SailTick 私人减肥监督教练 daemon（与 SailZen 同机部署）
#
# 与 scripts/sailzen-server.service 的用户、目录与 uv 路径保持完全一致。
#
# 安装步骤（在云端 Linux 服务器执行）:
#   sudo cp scripts/sailtick.service /etc/systemd/system/sailtick.service
#   # 按实际用户名与路径核对 User / WorkingDirectory / ExecStart / EnvironmentFile
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sailtick.service
#   sudo systemctl status sailtick.service --no-pager
#
# 灰度上线建议（首次启动强烈建议先观察 shadow -> canary -> live）:
#   uv run python -m sailtick canary set shadow --reason "initial cloud rollout"
#   sudo systemctl restart sailtick.service
#   uv run python -m sailtick monitor
#
# 注意:
#   - 依赖 sailzen-server.service（或旧名 my-server.service，按服务器实际名调整 After/Wants）
#   - 严禁 push origin（项目铁律）；本服务无 push 权限设计

[Unit]
Description=SailTick Private Health & Weight Coach Daemon
After=network-online.target sailzen-server.service
Wants=network-online.target sailzen-server.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/repos/SailZen
EnvironmentFile=-/home/ubuntu/repos/SailZen/.env.prod
Environment="PYTHONUNBUFFERED=1"
Environment="SAILTICK_ENV=prod"
Environment="SAILTICK_CONFIG=sailtick.yaml"
ExecStart=/home/ubuntu/repos/SailZen/.venv/bin/python -m sailtick --config sailtick.yaml run
Restart=always
RestartSec=10
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sailtick

# 安全隔离（保留 data/sailtick、logs/sailtick 与 uv 缓存可写）
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
