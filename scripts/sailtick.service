# systemd unit: SailTick 私人减肥监督教练 daemon（与 SailZen 同机部署）
#
# 安装:
#   sudo cp scripts/sailtick.service /etc/systemd/system/sailtick.service
#   # 编辑 WorkingDirectory / ReadWritePaths 中的 <USER> 为实际用户名
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sailtick
#
# 注意:
#   - 依赖 sailzen-server.service（票据/健康数据走 sail_server REST）
#   - 严禁 push origin（项目铁律）；本服务无 push 权限设计

[Unit]
Description=SailTick Private Weight-Loss Coach Daemon
After=network.target sailzen-server.service
Wants=sailzen-server.service

[Service]
Type=simple
User=%I
WorkingDirectory=/home/%I/SailZen
ExecStart=/usr/local/bin/uv run python -m sailtick run --config sailtick.yaml
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sailtick

# 环境（%I 为用户名；与 sail_server 共用 token 与 LLM key）
Environment="PYTHONUNBUFFERED=1"
Environment="SAILTICK_CONFIG=sailtick.yaml"
# Environment="SAILZEN_API_TOKEN=..."   # 建议放 /home/%I/SailZen/.env.prod，由 read_env 加载

# 安全
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
# 仅允许写 SailTick 自己的数据/日志目录（仓库代码由自我开发协议经 git 管理）
ReadWritePaths=/home/%I/SailZen/data/sailtick /home/%I/SailZen/logs/sailtick

[Install]
WantedBy=multi-user.target
